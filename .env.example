# Required backend settings. Copy your existing private values into the host.
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER/
DATABASE_NAME=TradingAPP
PURCHASES_COLLECTION=IOS
CORS_ORIGINS=http://localhost:8081

# Optional live portfolio prices.
UPSTOX_ACCESS_TOKEN=
UPSTOX_INSTRUMENT_MAP={}

# Optional automatic sector suggestions.
NVIDIA_API_KEY=dummy_replace_with_your_nvidia_api_key
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_INVOKE_URL=https://integrate.api.nvidia.com/v1/chat/completions
